{
  "manifest_version": 3,
  "name": "Foxbook 音声アシスタント UI 試作",
  "version": "0.1.0",
  "description": "共通音声インジケーターの表示と配置を検証する試作です。音声認識は行いません。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "音声アシスタント UI 試作", "default_popup": "preview.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["indicator.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbook-assistant-preview@foxbook.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
